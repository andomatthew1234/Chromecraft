{
  "name": "chromecraft",
  "productName": "Chromecraft",
  "version": "0.1.0",
  "description": "A dependable, local-first Electron browser for Windows and Linux.",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "package:linux": "electron-forge package --platform=linux --arch=x64",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:extensions:win": "node scripts/test-packaged-extensions.mjs",
    "diagnose:extension-webstore:win": "node scripts/diagnose-web-store-extension.mjs",
    "test:web-store-banner:win": "node scripts/validate-web-store-banner.mjs",
    "test:settings-scroll": "node scripts/test-settings-scroll.mjs",
    "test:sidebar": "node scripts/test-sidebar.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && prettier --check .",
    "format": "prettier --write .",
    "smoke:win": "node scripts/run-smoke.mjs --platform=win32",
    "smoke:linux": "node scripts/run-smoke.mjs --platform=linux",
    "perf:win": "node scripts/perf/run-perf.mjs --platform=win32",
    "perf:linux": "node scripts/perf/run-perf.mjs --platform=linux",
    "hyperdrive:benchmark:win": "node scripts/perf/run-hyperdrive.mjs --platform=win32",
    "hyperdrive:trace-google:win": "node scripts/perf/trace-google-hyperdrive.mjs",
    "hyperdrive:benchmark:linux": "node scripts/perf/run-hyperdrive.mjs --platform=linux"
  },
  "dependencies": {
    "material-symbols": "0.48.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "prettier": "3.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0"
}
